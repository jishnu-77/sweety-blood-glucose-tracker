# Copy this file to .env and adjust the values.

# --- PostgreSQL (used by docker-compose and to build the URLs below) ---
POSTGRES_USER=sweety
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sweety

# --- Backend ---
# Local development connection string (backend running on your machine).
# docker-compose overrides the host with "db" automatically.
DATABASE_URL=postgres://sweety:change_me@localhost:5432/sweety
# Separate database used ONLY by backend tests (tables are wiped on every run).
TEST_DATABASE_URL=postgres://sweety:change_me@localhost:5432/sweety_test

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Time zone used to decide what "today" means when checking for future dates.
APP_TIMEZONE=Asia/Kolkata
